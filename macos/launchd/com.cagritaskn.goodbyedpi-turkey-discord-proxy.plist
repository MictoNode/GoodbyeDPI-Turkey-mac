<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cagritaskn.goodbyedpi-turkey-discord-proxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/gost</string>
        <string>-L</string>
        <string>http://127.0.0.1:8080</string>
        <string>-F</string>
        <string>socks5://127.0.0.1:1080</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/goodbyedpi-discord-gost.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/goodbyedpi-discord-gost-error.log</string>
</dict>
</plist>
